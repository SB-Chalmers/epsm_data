  "completion_assumptions": {
    "baseline_finish": "A 40 mm bonded mineral finish replaces the former timber or softboard/rubber finish as a declared representative default. No original organic finish is buried during renovation.",
    "floor_renovation": "The source measures specify 40/45 mm warm-side EPS at conductivity 0.036 W/(m K). The 50 mm floating Generic HW Concrete finish is a declared family-proxy completion, not a TABULA product specification.",
    "wall_renovation": "Retain original concrete and 15 mm plaster. Advanced adds 40 mm stone wool at conductivity 0.036 W/(m K) on the room side, plus 13 mm gypsum. The source names facade board; reused internal batts and the finish remain explicit family adaptations.",
    "project_inputs": [
      "soil geometry and boundary method",
      "moisture, radon and vapour design",
      "load and reinforcement",
      "floor, door and stair clearances",
      "internal wall insulation moisture assessment and supports"
    ],
    "source_convention": "TABULA examples specify a completely conditioned cellar but apply unheated Cellar resistance 0.3 m²K/W and transmission factor 0.5 to ground-inclusive BETSI stock inputs. These observations cannot accept nominal layer U-values. Later-era secondary walls retain an explicit pre-1960 stock-average proxy."
  },
  "purpose": "Independent TABULA source topology, physical recipes and declared completion defaults for MF SE02–05; forward values are calculated from sourced grades and nominal dimensions, never fitted to effective ground U.",
  "source_convention": {
    "status": "source_incompatible",
    "ground_input_basis": "BETSI ISO 13370 ground-inclusive stock average",
    "additional_cellar_resistance_m2k_w": 0.3,
    "transmission_reduction_factor": 0.5,
    "cellar_condition": "C",
    "cellar_definition_locator": "TABULA.xlsm#Tab.Const.CellarCond!A14:C14",
    "cellar_border_locator": "TABULA.xlsm#Tab.Const.ConstrBorder!A13:E13",
    "betsi_basis_locator": "BETSI Energi i bebyggelsen (2010), printed p.17; floors Appendix 2 Table 8 p.166; buried walls Table 16 p.168"
  },
