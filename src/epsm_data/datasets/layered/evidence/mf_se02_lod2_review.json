      ]
    },
    "linoleum": {
      "status": "pending",
      "boverket_id": null,
      "decision": [
        "No direct Boverket 02.07.000 entry found. Manufacturer EPD needed; plastic-products mapping removed."
      ]
    },
    "woodfiber_board": {
      "status": "reviewed_proxy",
      "boverket_id": "6000000216",
      "decision": [
        "Soft board is not HDF. Candidate 6000000136 is a 50 kg/m3 batts proxy, not this 230 kg/m3 wet-process board; not adopted as resolved carbon.",
        "Wet-process hardboard carbon family proxy: same wood-fibre/process family, but generic hardboard about 940 kg/m3 and 1.7–6 mm differs from soft board 230 kg/m3 and 8–19 mm. No thermal density substitution or LCA certification. Candidate batts 6000000136 remains rejected.",
        "Supplier rated lambda 0.070, rho 230 and cp 2100 retained independently of carbon family."
      ]
    },
    "window_existing": {
      "status": "reviewed_proxy",
      "boverket_id": "6000000104",
      "decision": [
        "Simple whole-window model, not material-layer glazing. Optical properties are explicit assumptions.",
        "Modern wood triple-glazed carbon proxy for assumed wood-framed historic window; glazing/mass differences explicit. U=2.22 and clear-double-like optics remain independent nominal assumptions.",
        "SHGC 0.70 and VT 0.75 accepted clear-double-like whole-window assumptions, not inferred from U/carbon."
      ]
    },
    "gypsum_wind_sheathing": {
      "status": "reviewed_proxy",
      "boverket_id": "6000000015",
      "decision": [
        "Substitutes unidentified asphalt board with gypsum wind sheathing behind cladding. Same wind-control function, different composition; modern generic family, not original product. cp 1089.297 is captured gypsum-family assumption; absorptances are nominal.",
        "Swedish gypsum-board production since 1957 supports general era plausibility; GU9-specific historic use is assumed, not verified (gypsum_era)."
      ]
    },
    "plywood_separator": {
      "status": "reviewed_proxy",
      "boverket_id": "6000000023",
      "decision": [
        "Substitutes unidentified cardboard-like 5 mm layer with 5 mm plywood separator over concrete beneath attic wool. Not structural deck design or an archive transcription. Captured plywood lambda/rho/cp are nominal family assumptions; modern spruce/pine carbon proxy."
      ]
    },
    "rubber_floor_finish": {
      "status": "reviewed_proxy",
      "boverket_id": "6000000211",
      "decision": [
        "Substitutes linoleum with resilient rubber finish. Rubber flooring predates SE.02; typical Swedish residential prevalence is assumed. EPDM/SBR resource has <5% fillers; real flooring may contain more, so GWP composition mismatch is explicit and LCA readiness false. Lambda 0.17 has independent flooring evidence; rho 1200 and cp 1400 are assumptions."
      ]
    }
  },
  "sources": {
    "steico_thermal": {
      "title": "STEICO isorel technical data",
      "url": "https://www.steico.com/fileadmin/user_upload/Public_Docs/EUR_en/EUR_en_Technical_Data_Sheets/1._Product_information_wood_fibre_insulation/STEICO_technical-data-sheet_isorel_EUR_en_i.pdf",
