    "plywood_separator": {
      "url": "https://www.wisaplywood.com/specifying-wisa/sizes-thicknesses-and-weights/",
      "note": "5 mm is a standard spruce-plywood dimension. Captured Honeybee plywood thermal family supplies nominal properties, not this manufacturer's measured values."
    },
    "facade_arrangement": {
      "url": "https://www.rockwool.com/se/downloads-tools/broschyrer/tillaeggsisoleringsguide/",
      "note": "General retrofit context: no outdoor-ventilated gap between old and new insulation. One new brick veneer on assumed rebuilt foundation/engineered shelf supports, tied back to substrate; 25 mm drained/ventilated cavity is representative metadata, not design certification."
    },
