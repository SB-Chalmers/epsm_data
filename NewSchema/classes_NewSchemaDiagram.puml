Navigate to NewSchema Folder
Run:
pyreverse @(Get-ChildItem -Filter *.py | ForEach-Object { $_.BaseName }) -o 
puml -p NewSchemaDiagram

this will generate a UML diagram without the tuple layers and components shown as having a relationship to their respective classes this file has been edited to include that
_________________________________________________

@startuml
set namespaceSeparator none

' Classes with attributes and methods
class "Components2" as Components2 {
  archetype : str
  layers : Tuple[Tuple[Layer2, int], ...]
  name : str
  r_sum : float
  shearing_layer : ShearingLayer2
  to_dict() -> dict
}

class "Element2" as Element2 {
  age : int
  archetype : str
  components : Tuple[Components2, ...]
  name : str
  u_value : float
  check_tabula(tabula_data: dict) -> str | None
  to_dict() -> dict
}

class "EmbodiedCarbon2" as EmbodiedCarbon2 {
  A1_A3_conservative : float
  A1_A3_typical : float
  A4_transport : float
  A5_conservative : float
  biogenic_carbon : float
  boverket_name : str
  conservative_factor : float
  conversion_factor : float
  name : str
  resource_id : str
  technical_service_life : str
  to_dict() -> dict
}

class "Layer2" as Layer2 {
  archetype : str
  is_composite : bool
  layer_code : str
  materials : Tuple[Tuple[OpaqueMaterial2, float, float], ...]
  name : str
  r_value : float
  thickness : float
  check_thickness_consistency() -> str | None
  to_dict() -> dict
}

class "OpaqueMaterial2" as OpaqueMaterial2 {
  boverket_id : str
  conductivity : float
  density : float
  embodied_carbon : EmbodiedCarbon2
  json_id : str
  material_type : str
  name : str
  roughness : Roughness2
  solar_absorptance : float
  specific_heat : float
  thermal_absorptance : float
  uuid : UUID
  visible_absorptance : float
  to_dict() -> dict
}

class "Roughness2" as Roughness2 {
  name
}

class "ShearingLayer2" as ShearingLayer2 {
  name
}

' Explicit relationships
Components2 --> ShearingLayer2 : shearing_layer
Components2 --> Layer2 : layers
Element2 --> Components2 : components
Layer2 --> OpaqueMaterial2 : materials
OpaqueMaterial2 --> EmbodiedCarbon2 : embodied_carbon
OpaqueMaterial2 --> Roughness2 : roughness
@enduml
