Navigate to NewSchema Folder
Run:
pyreverse @(Get-ChildItem -Filter *.py | ForEach-Object { $_.BaseName }) -o 
puml -p NewSchemaDiagram

this will generate a UML diagram without the tuple layers and components shown as having a relationship to their respective classes this file has been edited to include that
_________________________________________________

@startuml
set namespaceSeparator none

' Classes with attributes and methods
class "Components" as Components {
  archetype : str
  layers : Tuple[Tuple[Layer, int], ...]
  name : str
  r_sum : float
  shearing_layer : ShearingLayer
  to_dict() -> dict
}

class "Element" as Element {
  age : int
  archetype : str
  components : Tuple[Components, ...]
  name : str
  u_value : float
  check_tabula(tabula_data: dict) -> str | None
  to_dict() -> dict
}

class "EmbodiedCarbon" as EmbodiedCarbon {
  A1_A3_conservative : float
  A1_A3_typical : float
  A4_transport : float
  A5_conservative : float
  biogenic_carbon : float
  boverket_name : str
  conservative_factor : float
  conversion_factor : float
  name : str
  resource_id : str
  technical_service_life : str
  to_dict() -> dict
}

class "Layer" as Layer {
  archetype : str
  is_composite : bool
  layer_code : str
  materials : Tuple[Tuple[OpaqueMaterial, float, float], ...]
  name : str
  r_value : float
  thickness : float
  check_thickness_consistency() -> str | None
  to_dict() -> dict
}

class "OpaqueMaterial" as OpaqueMaterial {
  boverket_id : str
  conductivity : float
  density : float
  embodied_carbon : EmbodiedCarbon
  json_id : str
  material_type : str
  name : str
  roughness : Roughness
  solar_absorptance : float
  specific_heat : float
  thermal_absorptance : float
  uuid : UUID
  visible_absorptance : float
  to_dict() -> dict
}
        
class "WindowMaterial" as WindowMaterial {
  boverket_id : str
  conductivity : float
  dirt_correction : float
  embodied_carbon : EmbodiedCarbon
  emissivity : float
  json_id : str
  material_type : str
  name : str
  solar_diffusing : bool
  solar_reflectance_back : float
  solar_reflectance_front : float
  solar_transmittance : float
  uuid : UUID
  to_dict() -> dict
}

class "Buildings" as Buildings {
  age : int
  elements : Tuple[Tuple[str, BuildingElementType], ...]
  name : str
  to_dict() -> dict
}

class "BuildingElementType" as BuildingElementType {
  name
  from_name(name: str) -> BuildingElementType | None
}

class "Roughness" as Roughness {
  name
}

class "ShearingLayer" as ShearingLayer {
  name
}

' Explicit relationships
Buildings --> BuildingElementType : elements
Buildings --> Element : elements
Element --> Components : components
Element --> BuildingElementType : element_type
Components --> ShearingLayer : shearing_layer
Components --> Layer : layers
Layer --> OpaqueMaterial : materials
OpaqueMaterial --> EmbodiedCarbon : embodied_carbon
OpaqueMaterial --> Roughness : roughness
WindowMaterial --> EmbodiedCarbon : embodied_carbon
@enduml
